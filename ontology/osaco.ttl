osaco:OSACohortConcept a owl:Class ;
    rdfs:label "OSA cohort concept"@en ;
    rdfs:comment "Root class: any concept represented by a variable in an obstructive sleep apnea cohort data dictionary."@en .

osaco:AnthropometricMeasure a owl:Class ;
