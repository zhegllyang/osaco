osaco:AlcoholUse a owl:Class ;
    rdfs:label "Alcohol use"@en ;
    rdfs:subClassOf osaco:MedicalHistory ;
    skos:definition "Usual Alcohol Intake per day (source: SHHS data dictionary)"@en ;
    skos:note "NCIT:C16273 Alcohol Consumption [mondo]" ;
    skos:relatedMatch <http://purl.obolibrary.org/obo/NCIT_C16273> .

osaco:AlphaGlucosidaseInhibitors a owl:Class ;
    rdfs:label "Alpha-Glucosidase Inhibitors"@en ;
    rdfs:subClassOf osaco:Medication ;
    skos:definition "Participant taking ALPHA-GLUCOSIDASE INHIBITORS within two weeks of the Sleep Heart Health Study Visit Two (SHHS2) visit.  All medications were recorded during the interview, and medication information was later categorized by physician review. (source: SHHS data dictionary)"@en ;
    skos:exactMatch <http://snomed.info/id/741013008> ;
    skos:note "SNOMED:741013008 Alpha-glucosidase inhibitor [snomed]" .

osaco:Amlodipine a owl:Class ;
    rdfs:label "Amlodipine"@en ;
    rdfs:subClassOf osaco:Medication ;
