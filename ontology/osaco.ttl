osaco:ArousalCriterion a owl:Class ;
    rdfs:label "arousal criterion"@en ;
    rdfs:comment "Whether EEG arousal was required or accepted as an alternative criterion for events counted in a polysomnography variable."@en .

osaco:OxygenSaturationMaximum a owl:Class ;
    rdfs:label "oxygen saturation maximum"@en ;
    rdfs:comment "Measurement family: oxygen saturation maximum, derived from polysomnography. Member variables are distinguished by the facet properties sleep-stage scope, body-position scope, desaturation threshold and arousal criterion rather than by separate classes."@en ;
    rdfs:subClassOf osaco:PolysomnographyMeasure .

osaco:BodyPositionScope a owl:Class ;
    rdfs:label "body position scope"@en ;
    rdfs:comment "The body-position stratum (supine, non-supine or all positions) over which a polysomnography variable was computed."@en .

osaco:SleepApneaTreatment a owl:Class ;
    rdfs:label "Sleep apnea treatment"@en ;
    rdfs:comment "A self-reported treatment for sleep-disordered breathing, such as positive airway pressure, an oral appliance or upper-airway surgery."@en ;
    rdfs:subClassOf osaco:OSACohortConcept ;
    owl:disjointWith osaco:AdministrativeVariable,
        osaco:AnthropometricMeasure,
        osaco:CardiovascularOutcome,
        osaco:ClinicalMeasure,
        osaco:Demographics,
        osaco:LifestyleFactor,
        osaco:MedicalHistory,
        osaco:Medication .

osaco:SleepStageScope a owl:Class ;
    rdfs:label "sleep stage scope"@en ;
    rdfs:comment "The sleep-stage stratum (REM, NREM or all sleep) over which a polysomnography variable was computed."@en .

osaco:OxygenSaturationPercentTime a owl:Class ;
    rdfs:label "oxygen saturation percent time"@en ;
    rdfs:comment "Measurement family: oxygen saturation percent time, derived from polysomnography. Member variables are distinguished by the facet properties sleep-stage scope, body-position scope, desaturation threshold and arousal criterion rather than by separate classes."@en ;
