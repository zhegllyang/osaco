@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix osaco: <https://w3id.org/osaco/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/osaco> a owl:Ontology ;
    dcterms:description "An application ontology of obstructive sleep apnea (OSA)-related variables, constructed from the Sleep Heart Health Study (SHHS v0.14.0) data dictionary and cross-validated against MESA (v0.8.0). Highly combinatorial polysomnography variables are modeled as measurement families with faceted properties (sleep stage, body position, desaturation threshold, arousal criterion). Concepts are cross-referenced to SNOMED CT, HPO, MONDO, and EFO via skos:exactMatch (equivalent) and skos:relatedMatch (related/broader)."@en ;
    dcterms:source "National Sleep Research Resource (sleepdata.org): SHHS, MESA" ;
    dcterms:title "Obstructive Sleep Apnea Cohort Variable Ontology (OSACO)"@en ;
    owl:versionInfo "0.1.1" .

osaco:isArousalCriterionOf a owl:ObjectProperty ;
    rdfs:label "isArousalCriterionOf"@en ;
    rdfs:comment "Inverse of hasArousalCriterion: links a facet value to the cohort variables computed under it."@en ;
    rdfs:domain osaco:ArousalCriterion ;
    rdfs:range osaco:PolysomnographyMeasure ;
    owl:inverseOf osaco:hasArousalCriterion .

osaco:isBodyPositionScopeOf a owl:ObjectProperty ;
    rdfs:label "isBodyPositionScopeOf"@en ;
    rdfs:comment "Inverse of hasBodyPositionScope: links a facet value to the cohort variables computed under it."@en ;
    rdfs:domain osaco:BodyPositionScope ;
    rdfs:range osaco:PolysomnographyMeasure ;
    owl:inverseOf osaco:hasBodyPositionScope .

osaco:isDesaturationThresholdOf a owl:ObjectProperty ;
    rdfs:label "isDesaturationThresholdOf"@en ;
    rdfs:comment "Inverse of hasDesaturationThreshold: links a facet value to the cohort variables computed under it."@en ;
    rdfs:domain osaco:DesaturationThreshold ;
    rdfs:range osaco:PolysomnographyMeasure ;
    owl:inverseOf osaco:hasDesaturationThreshold .

osaco:isSleepStageScopeOf a owl:ObjectProperty ;
    rdfs:label "isSleepStageScopeOf"@en ;
    rdfs:comment "Inverse of hasSleepStageScope: links a facet value to the cohort variables computed under it."@en ;
    rdfs:domain osaco:SleepStageScope ;
    rdfs:range osaco:PolysomnographyMeasure ;
    owl:inverseOf osaco:hasSleepStageScope .

osaco:nsrrVariableId a owl:DatatypeProperty ;
    rdfs:label "nsrrVariableId"@en ;
    rdfs:comment "NSRR data-dictionary identifier of the cohort variable."@en ;
    rdfs:domain osaco:OSACohortConcept ;
    rdfs:range xsd:string .

osaco:sourceCohort a owl:DatatypeProperty ;
    rdfs:label "sourceCohort"@en ;
    rdfs:comment "Cohort (SHHS or MESA) whose data dictionary defines the variable."@en ;
    rdfs:domain osaco:OSACohortConcept ;
    rdfs:range xsd:string .

osaco:var_mesa_ahi4p_nrem5 a owl:NamedIndividual,
        osaco:ApneaHypopneaIndex ;
    rdfs:label "MESA: Apnea-Hypopnea Index (NREM): (Apneas with no oxygen desaturation threshold used and with or without arousal+ hypopneas with > 30% flow reduction and >= 4% oxygen desaturation and with or without arousal) / hour of NREM sleep from type II polysomnography" ;
    osaco:hasArousalCriterion osaco:ArousalNotRequired ;
    osaco:hasBodyPositionScope osaco:AllPositions ;
    osaco:hasDesaturationThreshold osaco:Desat4Pct ;
    osaco:hasSleepStageScope osaco:NREMSleep ;
    osaco:nsrrVariableId "ahi4p_nrem5" ;
    osaco:sourceCohort "MESA" .

